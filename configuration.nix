# NixOS server configuration
# Lines marked "TO CHANGE" must be customized before the first deployment.
{ config, pkgs, ... }:

{
  imports = [ ./hardware-configuration.nix ];

  ##########################################################################
  # Boot — TO CHANGE if needed:
  # copy the boot.loader section from the /etc/nixos/configuration.nix
  # generated by the installer.
  ##########################################################################
  # Most common case (PC in UEFI mode):
  boot.loader.systemd-boot.enable = true;
  boot.loader.systemd-boot.configurationLimit = 5; # keeps /boot from filling up
  boot.loader.efi.canTouchEfiVariables = true;

  # Old PC with "legacy" BIOS: replace the 2 lines above with
  # boot.loader.grub.enable = true;
  # boot.loader.grub.device = "/dev/sda";
  # boot.loader.grub.configurationLimit = 5;

  ##########################################################################
  # Network
  ##########################################################################
  networking.hostName = "baguette"; # must match the name in flake.nix
  networking.networkmanager.enable = true;

  ##########################################################################
  # Language, keyboard, time zone
  ##########################################################################
  time.timeZone = "Europe/Paris";
  i18n.defaultLocale = "fr_FR.UTF-8";
  console.keyMap = "fr";

  ##########################################################################
  # User — TO CHANGE
  # Use EXACTLY the same name as the one created during installation
  # (otherwise you lose your sudo password).
  ##########################################################################
  users.users.aurele = {
    isNormalUser = true;
    extraGroups = [ "wheel" "networkmanager" ]; # wheel = allowed to use sudo
    openssh.authorizedKeys.keys = [
      # Contents of ~/.ssh/id_ed25519_baguette.pub on your PC
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEfSrRbFMllQJUaZgKIuckIuz2Ta7tcCbOucOBZ+kdXp aurele@fedora->baguette"
    ];
  };

  ##########################################################################
  # SSH: key-only login
  ##########################################################################
  services.openssh = {
    enable = true; # automatically opens port 22 in the firewall
    settings = {
      PasswordAuthentication = false;
      KbdInteractiveAuthentication = false;
      PermitRootLogin = "no";
    };
  };

  ##########################################################################
  # Remote access via Tailscale (no port to open on the router)
  # After the first deployment: sudo tailscale up
  # Then disable key expiry for this machine in the admin console
  # (https://login.tailscale.com/admin/machines > "..." > Disable key expiry),
  # otherwise remote access is lost after 180 days.
  ##########################################################################
  services.tailscale.enable = true;

  # Only if you ever expose SSH directly to the Internet
  # (port forwarding on the router):
  # services.fail2ban.enable = true;

  ##########################################################################
  # Installed software
  ##########################################################################
  environment.systemPackages = with pkgs; [
    git
    vim
    nano
    htop
    curl
  ];

  ##########################################################################
  # Nix: flakes + automatic cleanup
  ##########################################################################
  nix.settings = {
    experimental-features = [ "nix-command" "flakes" ];
    auto-optimise-store = true;
  };

  nix.gc = {
    automatic = true;
    dates = "weekly";
    options = "--delete-older-than 30d";
  };

  ##########################################################################
  # Automatic deployment from GitHub — TO CHANGE (your username)
  # The server checks the repository every 30 minutes and applies
  # the new config if there was a commit.
  ##########################################################################
  system.autoUpgrade = {
    enable = true;
    flake = "github:Staneo644/nixos-config#baguette";
    # Private repository: use this instead
    # flake = "git+ssh://git@github.com/Staneo644/nixos-config#baguette";
    flags = [ "--refresh" ];
    dates = "*:0/30";
    allowReboot = false;
  };

  ##########################################################################
  # If this is a laptop: don't suspend when the lid is closed
  ##########################################################################
  # services.logind.settings.Login.HandleLidSwitch = "ignore";

  ##########################################################################
  # TO CHANGE: use the value from your generated file
  # (then never change it again, even after an upgrade).
  ##########################################################################
  system.stateVersion = "26.05";

  services.navidrome = {
    enable = true;
    settings = {
      Address = "0.0.0.0";
      Port = 4533;
      MusicFolder = "/srv/music";
    };
    openFirewall = true;
  };

  # crée le dossier de musique, modifiable par ton utilisateur
  systemd.tmpfiles.rules = [ "d /srv/music 0755 aurele users -" ];
}
